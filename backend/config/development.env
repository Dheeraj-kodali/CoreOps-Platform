# Temple Visitor Management System Enterprise Edition v2.0
# Local Development Configuration Matrix

ENVIRONMENT=development
PROJECT_NAME="Temple Visitor Management System (Development)"
VERSION=2.0.0
LOG_LEVEL=DEBUG

DATABASE_URL=sqlite+aiosqlite:///./test_temple.db
SYNC_DATABASE_URL=sqlite:///./test_temple.db

SECRET_KEY=dev_secret_key_12345
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SYSTEM_API_KEY=sk_temple_v2_dev_key

BROADCAST_BATCH_SIZE=10
BROADCAST_RATE_LIMIT_MPS=10

BACKUP_ENABLED=false
BACKUP_DIRECTORY=./dev_backups
