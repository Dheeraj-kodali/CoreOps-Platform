# Temple Visitor Management System Enterprise Edition v2.0
# Production Configuration Matrix

ENVIRONMENT=production
PROJECT_NAME="Temple Visitor Management System Enterprise Edition"
VERSION=2.0.0
LOG_LEVEL=INFO

# SQLite Primary Database
DATABASE_URL=sqlite+aiosqlite:///./temple.db
SYNC_DATABASE_URL=sqlite:///./temple.db

# Security & Secret Management
SECRET_KEY=prod_sk_99887766554433221100_super_secret_jwt_key
ACCESS_TOKEN_EXPIRE_MINUTES=480
SYSTEM_API_KEY=sk_temple_v2_prod_998877665544

# Enterprise Broadcast Engine
BROADCAST_BATCH_SIZE=50
BROADCAST_RATE_LIMIT_MPS=50
BROADCAST_MAX_RETRIES=3
BROADCAST_RETRY_BACKOFF_BASE_SECONDS=60

# Disaster Recovery & Backups
BACKUP_ENABLED=true
BACKUP_RETENTION_COUNT=7
BACKUP_INTERVAL_HOURS=24
BACKUP_DIRECTORY=./backups

# Meta WhatsApp Cloud API
META_API_VERSION=v23.0
DEFAULT_PHONE_NUMBER_ID=1290699690788322
