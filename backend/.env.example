# Temple Visitor Management System Enterprise Edition v2.0
# Environment Variables Specification Template (.env.example)

# Environment & Application Setup
ENVIRONMENT=production
PROJECT_NAME="Sri Kalki Seva Alayam - Visitor Management System"
API_V1_STR="/api/v1"
API_V2_STR="/api/v2"

# Security & Tokens
SECRET_KEY=paste-your-production-secret-key-here
JWT_SECRET=paste-your-jwt-secret-here
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# Neon PostgreSQL Database Connection Strings
# Paste your Neon PostgreSQL database URL below. Example: postgresql+asyncpg://user:password@ep-xyz.neon.tech/dbname?sslmode=require
DATABASE_URL=
SYNC_DATABASE_URL=

# Redis & Celery Background Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Messaging Gateways
SMS_GATEWAY_URL="https://api.sms-provider.com/v1/send"
SMS_API_KEY=
WHATSAPP_GATEWAY_URL="https://graph.facebook.com/v18.0/me/messages"
WHATSAPP_ACCESS_TOKEN=

# Cloud Storage & Backups (AWS S3, Azure, GCS, Cloudflare R2, MinIO)
CLOUD_STORAGE_PROVIDER=LOCAL
BACKUP_ENCRYPTION_KEY=
